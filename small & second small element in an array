class Solution {
    public ArrayList<Integer> minAnd2ndMin(int[] arr) {
        // code here
        int small=Integer.MAX_VALUE;
        int ssmall=Integer.MAX_VALUE;
        int n=arr.length;
        for(int i=0;i<n;i++)
        {
            if(arr[i]<small)
            {
                ssmall=small;
                small=arr[i];
            }
            else if(arr[i]<ssmall && arr[i]!=small)
            {
                ssmall=arr[i];
            }
        }
        ArrayList<Integer> ans= new ArrayList<>();
        if(ssmall==Integer.MAX_VALUE)
        {
            ans.add(-1);
        }
        else{
            ans.add(small);
            ans.add(ssmall);
        }
        return ans;
    }
}

    


