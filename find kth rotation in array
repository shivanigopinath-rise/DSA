class Solution {
    public int findKRotation(int arr[]) {
        int x=-1;
        for(int i=0;i<arr.length-1;i++){
            if(arr[i]>arr[i+1]){
                x=i;
                break;
            }
        }
        if(x!=-1){
            return x+1;
        }
        return 0;
    }
}  
    
