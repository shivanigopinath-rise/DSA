class Solution {
    public ArrayList<Integer> sieve(int n) {
        // code here
        ArrayList<Integer> arr=new ArrayList<>();
        for(int i=0;i<=n;i++)
        {
            arr.add(1);
        }
        arr.set(0,0);
        if(n >= 1){
            arr.set(1,0);
        }
        for(int i=2;i<=Math.sqrt(n);i++)
        {
            if(arr.get(i)==1)
            {
                for(int j=2*i;j<=n;j=j+i)
                {
                    arr.set(j,0);
                }
            }
        }
        ArrayList<Integer> result=new ArrayList<>();
        for(int i=2;i<=n;i++){
            if(arr.get(i)==1){
                result.add(i);
            }
        }
        return result;
    }
}
