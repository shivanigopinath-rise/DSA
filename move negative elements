class Solution {
    public void segregateElements(int[] arr) {
    ArrayList<Integer> pos = new ArrayList<>();
    ArrayList<Integer> neg = new ArrayList<>();

    // Separate positive and negative elements
    for (int num : arr) {
        if (num < 0) {
            neg.add(num);
        } else {
            pos.add(num);
        }
    }

    // Merge them back into the original array
    int j = 0;
    for (int num : pos) {
        arr[j] = num;
        j++;
    }
    for (int num : neg) {
        arr[j] = num;
        j++;
    }
    }
}
