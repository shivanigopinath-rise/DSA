class Solution {
    public void sortInWave(int a[]) {
                // code here
                int n = a.length;
                for(int i=0;i<n-1;i=i+2){
                    int temp = a[i];
                    a[i] = a[i+1];
                    a[i+1] = temp;

                }
            }
        }
    

