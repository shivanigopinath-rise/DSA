
import java.util.Scanner;
class Main {
    static int Sum(int n)
    {
        if(n==0){
            return 0;
        }
        else{
            return n+Sum(n-1);
           
        }
        
    }
        public static void main(String[]args)
        {
            Scanner scan=new Scanner(System.in);
            System.out.println("ENTER n:");
            int n=scan.nextInt();
        System.out.println("Sum = "+Sum(n));
    }
}
