class Solution {
    public int inversionCount(int a[]) {
        // code here
        int n=a.length;
        int count=0;
        for(int i=0;i<n-1;i++)
        {
            for(int j=i+1;j<n;j++)
            {
            if(a[i]>a[j] && i<j)
            {
             count ++;   
            }
        }
        }
        return count;
        
    }
}
