
class Main {
static int sumarray(int a[],int n,int i)
{
    if(i>=n)
    {
        return 0;
    }
    else
    {
        
        return a[i]+sumarray( a, n,i+1);
    }
}
public static void main(String[] args) 
    {
       int a[]={1,23,4,25,16};
       int sum=sumarray(a,5,0);
        System.out.print("Sum: "+sum);
    }
}
