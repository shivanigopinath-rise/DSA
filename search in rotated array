class Solution {
    int search(int[] a, int key) {
        // code here
        int n=a.length;
        int i=0;
        int j=n-1;
        while(i<=j)
        {
            int mid=(i+j)/2;
            if(a[mid]==key)
            {
                return mid;
            }
            if(a[mid]>=a[i])//left subarray sorted?
            {
                if(key>=a[i] && key<a[mid])
                {
                    j=mid-1;
                }
                else
                {
                    i=mid+1;
                }
            }
           else//right subarray sorted?
            {
                if(key>a[mid] && key<=a[j])
                {
                    i=mid+1;
                }
                else
                {
                    j=mid-1;
                }
            }
            
        }
        return -1;
    }
}
