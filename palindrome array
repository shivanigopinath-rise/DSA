class Solution {
    public static boolean isPalindrome(int[] arr) {
        // code here
        int n=arr.length;
        int count=0;
        for(int i=0;i<n;i++)
        {
            if(arr[i]==arr[n-1-i])
            {
                count++;
            }
        }
        if(count==n)
        {
            return true;
        }
        
        return false;
    }
    
}
