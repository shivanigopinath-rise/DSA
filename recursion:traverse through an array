
class Main {
  static void   arraytraverse(int a[],int n,int i)
{
    if(i>=n){
        return;
    }
    else
    {
        System.out.print(a[i]+" ");
        arraytraverse( a, n,i+1);
    }
   
}
    public static void main(String[] args) {
       int a[]={1,23,4,25,16};
        arraytraverse(a,5,0);
    }
}
