class Solution {
    public void rotate(int[] nums, int k) {
        int n=nums.length;
        k=k%n;
        int[] num2=new int[n];
        
        for(int i=n-k;i<n;i++)
        {
            num2[i-(n-k)]=nums[i];
         
        }  
        
        for(int i=0;i<n-k;i++)
        {
            num2[k+i]=nums[i];
          
        }
        
        for(int i=0;i<n;i++)
        {
            nums[i]=num2[i];
        }
    }
}
