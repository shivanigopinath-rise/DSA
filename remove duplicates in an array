class Solution {
    ArrayList<Integer> removeDuplicates(int[] arr) {
        // code here
        int j=0;
         ArrayList<Integer> result=new  ArrayList<>();
        int n=arr.length;
        
        for(int i=0;i<n-1;i++)
        {
            if(arr[i]!=arr[i+1])
            {
                arr[j]=arr[i];
                j++;
            }
        }
            arr[j++]=arr[n-1];
            for(int i=0;i<j;i++)
            {
            result.add(arr[i]);
            }
            return result;
    }
}
